[Unit]
Description=Private TradingAgents research dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=tradingagents
Group=tradingagents
WorkingDirectory=/opt/tradingagents
Environment=HOME=/var/lib/tradingagents
Environment=DASHBOARD_STATE_DIR=/var/lib/tradingagents/dashboard
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/tradingagents/.venv/bin/gunicorn --bind 127.0.0.1:8050 --workers 1 --threads 4 --timeout 45 --limit-request-line 2048 --limit-request-field_size 4096 dashboard.app:create_app()
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tradingagents
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=512M
TasksMax=64
CPUQuota=50%

[Install]
WantedBy=multi-user.target
