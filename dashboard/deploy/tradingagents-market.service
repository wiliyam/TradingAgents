[Unit]
Description=TradingAgents Angel One market feed and paper ledger
After=network-online.target
Wants=network-online.target

[Service]
User=tradingagents
Group=tradingagents
WorkingDirectory=/opt/tradingagents
Environment=HOME=/var/lib/tradingagents
Environment=DASHBOARD_STATE_DIR=/var/lib/tradingagents/dashboard
Environment=ANGEL_PUBLIC_IP=192.9.166.69
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/tradingagents/.venv/bin/uvicorn dashboard.broker.service:create_market_app --factory --host 127.0.0.1 --port 8060 --workers 1 --no-access-log --ws-max-size 16384
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tradingagents
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=512M
TasksMax=64
CPUQuota=50%

[Install]
WantedBy=multi-user.target
